      "args": [
        {
          "type": "range",
          "name": "soc",
          "min": 0,
          "max": 100,
          "step": 1,
          "label": "%",
          "labelDecimals": 0
        }
      ]
    },
    {
      "id": "set_dispatch_active_power",
      "title": {
        "en": "Set dispatch active power",
        "nl": "Stel dispatch actief vermogen in"
      },
      "titleFormatted": {
        "en": "Set dispatch active power to [[power]] W",
        "nl": "Stel dispatch actief vermogen in op [[power]] W"
      },
      "args": [
        {
          "type": "range",
          "name": "power",
          "min": -32000,
          "max": 32000,
          "step": 100,
          "label": "W",
          "labelDecimals": 0
        }
      ]
    }
  ]
