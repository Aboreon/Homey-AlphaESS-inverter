{
  "triggers": [
    {
      "id": "panels_onoff_changed",
      "title": {
        "en": "Solar panels turned on or off",
        "nl": "Zonnepanelen aan- of uitgezet"
      },
      "tokens": [
        {
          "name": "onoff",
          "type": "boolean",
          "title": { "en": "On", "nl": "Aan" }
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "panels_is_on",
      "title": {
        "en": "Solar panels !{{are|aren't}} on",
        "nl": "Zonnepanelen !{{zijn|zijn niet}} aan"
      },
      "titleFormatted": {
        "en": "Solar panels !{{are|aren't}} on",
        "nl": "Zonnepanelen !{{zijn|zijn niet}} aan"
      }
    }
  ],
  "actions": [
    {
      "id": "set_panels_onoff",
      "title": {
        "en": "Turn solar panels on or off",
        "nl": "Zet zonnepanelen aan of uit"
      },
      "titleFormatted": {
        "en": "Turn solar panels [[onoff]]",
        "nl": "Zet zonnepanelen [[onoff]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "onoff",
          "values": [
            { "id": "true", "label": { "en": "On", "nl": "Aan" } },
            { "id": "false", "label": { "en": "Off", "nl": "Uit" } }
          ]
        }
      ]
    }
  ]
}
